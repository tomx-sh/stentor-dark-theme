  "tokenColors": [
    {
      "name": "source.ts",
      "scope": "source.ts, constant.numeric, meta.rule.lexer.antlr",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "import statements",
      "scope": "keyword, keyword.control, storage.modifier.ts, support.class.promise, storage.modifier.async, entity.name.tag.wildcard, storage.type, storage.modifier.sql",
      "settings": {
        "foreground": "#d40067"
      }
    },
    {
      "name": "string",
      "scope": "string, punctuation.definition.string.begin,punctuation.definition.string.end",
      "settings": {
        "foreground": "#ea0c00"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, keyword.operator.type.annotation, keyword.operator.assignment, meta.brace.round, meta.brace.square, meta.rule.parser.antlr, keyword.operator.key-value.rust, keyword.operator.access.dot.rust",
      "settings": {
        "foreground": "#cbcbcb"
      }
    },
    {
      "name": "Referenced variables",
      "scope": "variable.other, variable.other.object.tsx, storage.type.function.antlr, constant.other.antlr, meta.interpolation.rust",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Type names",
      "scope": "entity.name.type, entity.other.inherited-class.ts, support.type, keyword.other.unit, storage.type.sql",
      "settings": {
        "foreground": "#00abcd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type declarations",
      "scope": "entity.name.type",
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Go types",
      "scope": "source.go storage.type",
      "settings": {
        "foreground": "#00abcd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function names",
      "scope": "entity.name.function, variable.scss, entity.name.rule.antlr",
      "settings": {
        "foreground": "#295ed1"
      }
    },
    {
      "name": "Function declarations",
      "scope": "meta.definition.function, entity.name.rule.antlr, storage.type.var.antlr, entity.name.function.rust",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Object property and parameter names",
      "scope": "variable.object.property, meta.object-literal.key, variable.parameter, entity.other.attribute-name.tsx, entity.other.attribute-name.html, support.type.property-name.css, variable.other.property.go, meta.function.definition.rust variable.other.rust, support.variable.property",
      "settings": {
        "foreground": "#44484e",
        "fontStyle": ""
      }
    },
    {
      "name": "Logical operators",
      "scope": "keyword.operator, punctuation.accessor.optional",
      "settings": {
        "foreground": "#00a938"
      }
    },
    {
      "name": "Comments",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#cbcbcb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Component names",
      "scope": "support.class.component.tsx, entity.other.attribute-name.id.css, entity.other.attribute-name.class.css, storage.type.var.antlr, constant.other.table-name.sql",
      "settings": {
        "foreground": "#9d00ff"
      }
    },
    {
      "name": "Default HTML tag names",
      "scope": "entity.name.tag.html, entity.name.tag.tsx, entity.name.tag.css, meta.attribute.rust, constant.other.database-name.sql",
      "settings": {
        "foreground": "#5d00ff"
      }
    }
  ]
}